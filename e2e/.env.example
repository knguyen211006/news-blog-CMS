# Playwright E2E — Biến môi trường
# Sao chép file này thành .env và điền thông tin thực tế

# URL gốc của dev server
BASE_URL=http://127.0.0.1:8092/news-blog-cms/
PHP_BINARY=C:/xampp/php/php.exe
PLAYWRIGHT_BROWSERS_PATH=.browsers
INVALID_EMAIL=invalid@e2e.invalid
INVALID_PASSWORD=DefinitelyNotAValidPassword
EMPTY_QUERY=E2E_NO_MATCH_29b6f1fdbe9d4664b0d51ef3
CATEGORY_SLUG=cong-nghe
TAG_SLUG=php

# Tài khoản Admin demo
ADMIN_EMAIL=admin@newsblog.local
ADMIN_PASSWORD=Demo@12345

# Tài khoản Author demo
AUTHOR_EMAIL=author1@newsblog.local
AUTHOR_PASSWORD=Demo@12345

# Tài khoản User/Reader demo
USER_EMAIL=reader1@newsblog.local
USER_PASSWORD=Demo@12345
